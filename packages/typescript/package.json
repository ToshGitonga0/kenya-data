{
  "name": "@kenya-data/core",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Kenya Data structured dataset",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --loader ts-node/esm --test tests/*.test.ts",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToshGitonga0/kenya-data.git"
  },
  "homepage": "https://github.com/ToshGitonga0/kenya-data#readme",
  "bugs": {
    "url": "https://github.com/ToshGitonga0/kenya-data/issues"
  },
  "author": "ToshGitonga0",
  "publishConfig": {
    "access": "public"
  }
}
